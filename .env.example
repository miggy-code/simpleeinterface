# ── DeepSeek ──────────────────────────────────────────────────────────────────
# Legacy/disabled in the simplified internal workflow. Keep only if you re-enable
# old AI hook or campaign generation endpoints.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Legacy/disabled in the simplified internal workflow.
OPENAI_API_KEY=sk-...

# ── DeBounce ─────────────────────────────────────────────────────────────────
# Required before pushing leads to Instantly. Only "Safe to Send" results pass.
DEBOUNCE_API_KEY=...

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=pat...
# Defaults below match the live ThrottlGTM base if these are unset:
# base appfS9ODVKZ2XEATW
AIRTABLE_BASE_ID=appfS9ODVKZ2XEATW
# Leads table: tblfv5ljYNeAqz4WL
AIRTABLE_LEADS_TABLE_ID=tblfv5ljYNeAqz4WL
# Active Outreach table: tblV5JazpXNARFbRW
AIRTABLE_ACTIVE_OUTREACH_TABLE_ID=tblV5JazpXNARFbRW
# Re-engagement Archive table: tblg1X65XmCpOYh7Q
AIRTABLE_ARCHIVE_TABLE_ID=tblg1X65XmCpOYh7Q

# ── Instantly ─────────────────────────────────────────────────────────────────
# v2 API key required. Source of truth for campaigns and lead enrollment.
INSTANTLY_API_KEY=...
INSTANTLY_SENDER_EMAIL=you@yourdomain.com
INSTANTLY_SENDER_NAME=Your Name

# ── App auth ──────────────────────────────────────────────────────────────────
# Basic-auth gate on every route. Leave blank to disable (NOT recommended).
DASHBOARD_USERNAME=throttl
DASHBOARD_PASSWORD=...

# ── Cron ──────────────────────────────────────────────────────────────────────
# Required for /api/cron/* endpoints (Vercel Cron secret).
CRON_SECRET=...
